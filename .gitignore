# ── Зависимости и сборка ─────────────────────────────────────
node_modules/
.next/
out/
build/
dist/

# ── Окружение ────────────────────────────────────────────────
# Секреты и пароль админки — только локально, см. web/.env.example
.env
.env.local
.env.*.local

# ── База и загруженные файлы ─────────────────────────────────
# Контент, а не код: на сервере живёт на диске, локально — своя копия.
*.db
*.db-journal
*.sqlite
*.sqlite3
web/public/uploads/*
!web/public/uploads/.gitkeep

# ── Сгенерированный клиент Prisma ────────────────────────────
# Создаётся командой prisma generate при каждой сборке.
web/src/generated/prisma/

# ── Исходные фото ────────────────────────────────────────────
# Оригиналы для слотов: тяжёлые, в репозитории не нужны —
# на сайте лежат уже сжатые копии в webp.
Photo/

# ── Служебное от инструментов ────────────────────────────────
# web/.claude/skills — симлинки на скиллы Prisma. В Windows они битые
# и ломают обход дерева: без этой строки git не видит папку web целиком.
web/.claude/
web/.agents/
.claude/settings.local.json

# ── Системное ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
.vscode/
.idea/

# ── Временное ────────────────────────────────────────────────
*.tmp
*.tmp.*
next-env.d.ts
